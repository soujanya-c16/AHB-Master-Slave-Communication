module master_ahb(

    input              CLK_MASTER,
    input              RESET_MASTER,

    // Slave Interface
    input              HREADY,
    input      [31:0]  HRDATA,

    // User Interface
    input      [31:0]  data_top,
    input              write_top,
    input      [31:0]  addr_top,
    input      [3:0]   beat_length,
    input              enb,
    input              wrap_enb,

    // AHB Outputs
    output     [31:0]  HADDR,
    output reg         HWRITE,
    output reg [1:0]   HTRANS,
    output reg [2:0]   HBURST,
    output reg [2:0]   HSIZE,
    output reg [31:0]  HWDATA,

    output             fifo_empty,
    output             fifo_full

);

//========================================================
// State Encoding
//========================================================

parameter idle               = 3'd0;
parameter write_state_addr   = 3'd1;
parameter write_state_data   = 3'd2;
parameter read_state_addr    = 3'd3;
parameter read_state_data    = 3'd4;

//========================================================
// Registers
//========================================================

reg [2:0] present_state;
reg [2:0] next_state;

reg [31:0] addr_internal;

reg [3:0] count;

reg [31:0] mem [0:15];

reg [3:0] wr_ptr;
reg [3:0] rd_ptr;

integer i;

//========================================================
// FIFO Status
//========================================================

assign fifo_empty = (wr_ptr == rd_ptr);

assign fifo_full =
        ((wr_ptr + 1'b1) == rd_ptr);

//========================================================
// Address Output
//========================================================

assign HADDR = addr_internal;

//========================================================
// FIFO Write
//========================================================

always @(posedge CLK_MASTER or posedge RESET_MASTER)
begin

    if(RESET_MASTER)
    begin

        wr_ptr <= 0;
        rd_ptr <= 0;

        for(i=0;i<16;i=i+1)
            mem[i] <= 32'd0;

    end

    else
    begin

        if(write_top && !fifo_full)
        begin
            mem[wr_ptr] <= data_top;
            wr_ptr <= wr_ptr + 1'b1;
        end

    end

end

//========================================================
// State Register
//========================================================

always @(posedge CLK_MASTER or posedge RESET_MASTER)
begin

    if(RESET_MASTER)
    begin

        present_state <= idle;

        count <= 0;

        addr_internal <= 32'd0;

    end

    else
    begin

        present_state <= next_state;

    end

end

//========================================================
// Next State Logic & Output Logic
//========================================================

always @(*)
begin

    // Default Outputs

    next_state = present_state;

    HWRITE = 1'b0;
    HTRANS = 2'b00;          // IDLE
    HBURST = 3'b000;         // SINGLE
    HSIZE  = 3'b010;         // 32-bit
    HWDATA = 32'd0;

    case(present_state)

    //====================================================
    // IDLE STATE
    //====================================================

    idle :
    begin

        count = 0;

        if(enb && HREADY)
        begin

            // SINGLE WRITE

            if(write_top && (beat_length == 1))
            begin

                HWRITE = 1'b1;
                HBURST = 3'b000;      // SINGLE
                next_state = write_state_addr;

            end

            // INCR4 WRITE

            else if(write_top &&
                    (beat_length == 4) &&
                    (wrap_enb == 0))
            begin

                HWRITE = 1'b1;
                HBURST = 3'b011;      // INCR4
                next_state = write_state_addr;

            end

        end

    end

    //====================================================
    // WRITE ADDRESS
    //====================================================

    write_state_addr :
    begin

        HWRITE = 1'b1;

        HSIZE = 3'b010;

        HTRANS = 2'b10;          // NONSEQ

        next_state = write_state_data;

    end

    //====================================================
    // WRITE DATA
    //====================================================

    write_state_data :
    begin

        HWRITE = 1'b1;

        HSIZE = 3'b010;

        if(HREADY)
        begin

            HWDATA = mem[rd_ptr];

            // SINGLE

            if(beat_length == 1)
            begin

                HTRANS = 2'b10;

                next_state = idle;

            end

            // INCR4

            else if(beat_length == 4)
            begin

                if(count == 3)
                begin

                    HTRANS = 2'b11;      // Last SEQ

                    next_state = idle;

                end

                else
                begin

                    HTRANS = 2'b11;      // SEQ

                    next_state = write_state_data;

                end

            end

        end

    end

    default :
        next_state = idle;

    endcase

end

//========================================================
// Sequential Logic
//========================================================

always @(posedge CLK_MASTER or posedge RESET_MASTER)
begin

    if(RESET_MASTER)
    begin

        rd_ptr        <= 4'd0;
        count         <= 4'd0;
        addr_internal <= 32'd0;

    end

    else
    begin

        case(present_state)

        //------------------------------------------------
        // IDLE
        //------------------------------------------------

        idle:
        begin

            count <= 4'd0;

            if(enb)
                addr_internal <= addr_top;

        end

        //------------------------------------------------
        // WRITE DATA
        //------------------------------------------------

        write_state_data:
        begin

            if(HREADY)
            begin

                // Read one word from FIFO
                HWDATA <= mem[rd_ptr];

                rd_ptr <= rd_ptr + 1'b1;

                //------------------------------------------------
                // SINGLE
                //------------------------------------------------

                if(beat_length == 1)
                begin

                    count <= 4'd0;

                end

                //------------------------------------------------
                // INCR4
                //------------------------------------------------

                else if(beat_length == 4)
                begin

                    if(count < 3)
                    begin

                        count <= count + 1'b1;

                        addr_internal <= addr_internal + 32'd4;

                    end
                    else
                    begin

                        count <= 4'd0;

                    end

                end

            end

        end

        default:
        begin

            count <= count;

        end

        endcase

    end

end
endmodule
